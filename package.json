{
  "name": "ssealed",
  "version": "0.7.80",
  "type": "module",
  "description": "LLM-friendly design scaffold CLI for repository documentation, agent instructions, contracts, validations, and hygiene files.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0disoft/ssealed.git"
  },
  "bugs": {
    "url": "https://github.com/0disoft/ssealed/issues"
  },
  "homepage": "https://github.com/0disoft/ssealed#readme",
  "bin": {
    "ssealed": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "keywords": [
    "ai-agents",
    "bun",
    "cli",
    "design-docs",
    "nodejs",
    "scaffold"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke:node-runtime": "node scripts/smoke-runtime.mjs node",
    "smoke:bun-runtime": "node scripts/smoke-runtime.mjs bun",
    "smoke:package-surface": "npm pack --dry-run --json",
    "smoke:packed-install": "node scripts/smoke-packed-install.mjs",
    "smoke": "bun run smoke:node-runtime && bun run smoke:bun-runtime && bun run smoke:package-surface && bun run smoke:packed-install",
    "check": "bun run typecheck && bun run test && bun run build && bun run smoke",
    "dev": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
